# Copieu aquest fitxer com a .env i canvieu els valors.
# La contrasenya ha de complir la política de SQL Server:
# mínim 8 caràcters i 3 de 4 tipus (majúscules, minúscules, dígits, símbols).
MSSQL_SA_PASSWORD=CanviaAixo!2026

# Edició: EnterpriseDeveloper | StandardDeveloper | Express | Evaluation
MSSQL_PID=EnterpriseDeveloper

# Tag de la imatge (fixeu-lo per tenir entorns reproduïbles)
MSSQL_TAG=2025-latest

# Port de l'amfitrió on s'exposa SQL Server
MSSQL_HOST_PORT=1433

MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS
MSSQL_MEMORY_LIMIT_MB=2048
